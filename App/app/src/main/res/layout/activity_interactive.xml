<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".InteractiveActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        tools:title="Der Feed" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_l">

        <!-- 1. Einführung -->
        <LinearLayout
            android:id="@+id/section_intro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interactive_badge"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/text_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Ausstellung.Body"
                tools:text="Gleich startet ein Feed …" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_start_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:minHeight="56dp"
                android:text="@string/feed_start" />
        </LinearLayout>

        <!-- 2. Feed -->
        <LinearLayout
            android:id="@+id/section_feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_feed_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Beitrag 4 von 20" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_post"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/space_m"
                android:layout_weight="1"
                app:cardCornerRadius="24dp">

                <TextView
                    android:id="@+id/text_post"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/space_l"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold"
                    tools:text="Nur heute: −50 %" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/feed_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <!-- 3. Quiz -->
        <LinearLayout
            android:id="@+id/section_quiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_title"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/text_quiz_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:textAppearance="@style/TextAppearance.Ausstellung.Headline"
                tools:text="Was stand auf Beitrag Nummer 10?" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="56dp" />
        </LinearLayout>

        <!-- 4. Ergebnis -->
        <ScrollView
            android:id="@+id/section_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:textAppearance="@style/TextAppearance.Ausstellung.Display"
                    tools:text="Knapp daneben." />

                <TextView
                    android:id="@+id/text_result_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.Ausstellung.Body" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/question_title"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                        <TextView
                            android:id="@+id/text_result_question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="serif"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_back_to_tour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:minHeight="56dp"
                    android:text="@string/back_to_tour" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
