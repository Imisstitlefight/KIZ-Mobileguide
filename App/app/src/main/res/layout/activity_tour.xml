<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TourActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_tour"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/tour_title" />

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_m"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="2 von 6 Stücken angesehen" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_tour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            app:trackCornerRadius="4dp"
            app:trackColor="?attr/colorPrimaryContainer"
            app:trackThickness="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_exhibits"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_exhibit" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:text="@string/scan_qr"
        app:icon="@drawable/ic_qr" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
